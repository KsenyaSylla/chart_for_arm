установить NATS Server
  apt-get install nats-server

где лежит конфиг?
  /etc/nats-server.conf 

проверить статус NATS server
  systemctl status nats-server

запустить NATS Server
  systemctl start nats-server

установить nats-cli
  curl -sf https://binaries.nats.dev/nats-io/natscli/nats@latest | sh

получить инфо про сервер
  ./nats -s localhost:4222 --user sys --password pass server info

получить инфо про текущий аккаунт
  ./nats -s localhost:4222 --user sys --password pass account info
 
сохранить ключ
  ./nats -s localhost:4222 --user user --password user kv put QUEEN a-night-at-the-opera '{"all-chats": { "label": "Обработанных ботом", "absolute": 37202, "relative": 33.1 },"chats-processed": { "label": "Обработанных ботом и оператором", "absolute": 20238, "relative": 18.01 }, "chats-unassigned": { "label": "Потерянных на операторе", "absolute": 371, "relative": 0.33 }, "chats-lost-by-operator": { "label": "Определено тематик", "absolute": 46402, "relative": 24.16 } }'

получить данные по ключу
  ./nats -s localhost:4222 --user user --password user kv get QUEEN a-night-at-the-opera --raw

